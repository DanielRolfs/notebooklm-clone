# Copy to .env.local and fill in. Never commit real values.

# Supabase dashboard > Project Settings > API (or "Data API"): Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard > Project Settings > API Keys: the publishable (anon) key.
# Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase dashboard > Project Settings > API Keys: the secret key
# (on the legacy tab it is called "service_role").
# Server only. Bypasses Row Level Security, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# openrouter.ai > Keys > Create key. Used for chat and embeddings.
# Server only. Needs a few dollars of credit.
OPENROUTER_API_KEY=
